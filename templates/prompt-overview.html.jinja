{% extends "base.html.jinja" %}
{% block title %}Prompts{% endblock %}

{% block content %}
<body>
    {% with messages = get_flashed_messages(with_categories = True) %}
        {% if messages %}
            <ul>
                {% for category, message in messages %}
                    <li class="{{category}}">{{message}}</li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endwith %}
</body>
<section>
    <h1>AI Prompts</h1>

    <table>
        <tr>
            <th>Prompt</th>
            <th>Redacteur</th>
            <th>Toetsvragen ingedeeld</th>
            <th>Correct</th>
            <th>Succespercentage</th>
            <th>Acties</th>
        </tr>
        {% for prompt in prompts_info %}
        <tr>
            <td>{{ prompt.prompt_name }}</td>
            <td>{{ prompt.display_name }}</td>
            <td>{{ prompt.questions_count }}</td>
            <td>{{ prompt.questions_correct }}</td>
            {% if prompt.questions_count %}
                <td>{{ (prompt.questions_correct / prompt.questions_count * 100)|int }}%</td>
            {% else %}
                <td>0%</td>
            {% endif %}
            <td>
                <a href="/prompt/{{prompt.prompts_id}}">
                    <button type="button">Details</button>
                </a>
            </td>
        </tr>
        {% endfor %}
    </table>

    <a href="/prompt/create">
        <button>Nieuwe prompt toevoegen</button>
    </a>
</section>
{% endblock %}