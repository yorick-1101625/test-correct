{% extends "base.html.jinja" %}
{% block title %}Prompts{% endblock %}
{% block styles %}
    <link rel="stylesheet" href="{{ url_for('static', filename='prompt-overview.css') }}">
{% endblock %}
{% block content %}
<section>
    <h1>AI Prompts</h1>

    <table class="overview-container">
        <tr class="row-head row">
            <th class="col1">Prompt</th>
            <th class="col2">Redacteur</th>
            <th class="col3">Toetsvragen ingedeeld</th>
            <th class="col4">Succespercentage</th>
            <th class="col5">Acties</th>
        </tr>
        {% for prompt in prompts_info %}
        <tr class="row">
            <td class="col1">{{ prompt.prompt_name }}</td>
            <td class="col2">{{ prompt.display_name }}</td>
            <td class="col3">{{ prompt.questions_count }}</td>
            {% if prompt.questions_count %}
                <td class="col4">{{ (prompt.questions_correct / prompt.questions_count * 100)|int }}%</td>
            {% else %}
                <td class="col4">0%</td>
            {% endif %}
            <td class="col5">
                <a href="/prompt/{{prompt.prompts_id}}">
                    <button class="detail-btn" type="button">Details</button>
                </a>
            </td>
        </tr>
        {% endfor %}
    </table>

    <a href="/prompt/create">
        <button class="btn">Nieuwe prompt toevoegen</button>
    </a>
</section>
{% endblock %}