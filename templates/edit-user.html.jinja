{% extends "base.html.jinja" %}
{% block title %}Wijzig redacteur{% endblock %}

{% block content %}
<section>
    <form method="POST">
        <label for="display_name">Naam</label><br>
        <input type="text" id="display_name" name="display_name" value="{{display_name}}"><br>

        <label for="login">Email / login</label><br>
        <input type="email" id="login" name="login" value="{{login}}"><br>

        <label for="password">Wachtwoord</label><br>
        <input type="password" id="password" name="password" value="{{password}}"><br>

        <label for="is_admin">Is admin?</label>
        {% if is_admin == 1 %}
            <input type="checkbox" id="is_admin" name="admin" value="1" checked><br>
        {% else %}
            <input type="checkbox" id="is_admin" name="admin" value="1"><br>
        {% endif %}

        <input type="submit" name="submit" value="Opslaan">
        <input type="submit" name="submit" value="Verwijderen">
    </form>
</section>
{% endblock %}