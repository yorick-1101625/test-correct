{% extends "base.html.jinja" %}
{% block title %}Prompt Antwoord{% endblock %}
{% block styles %}
    <link rel="stylesheet" href="{{ url_for('static', filename='single-question.css') }}">
{% endblock %}

{% block content %}
<section>
    <!--Details of the question-->
    <div>
        <h1 class="page-title">Vraag indexeren naar {{ taxonomy }}</h1>
        <p class="question">{{ single_question.question }}</p>
    </div>
    <div class="question-categories-grid">
        <span>Vak:</span>
        <span>{{ single_question.subject|title }}</span>

        <span>Onderwijs Niveau:</span>
        <span>{{ single_question.education_level|title }}</span>

        <span>Leerjaar:</span>
        <span>{{ single_question.grade }}</span>
    </div>

    <!-- The response of the gpt -->
    {% if gpt_response.uitleg %}
        <p class="explanation">
            {{ gpt_response.uitleg }}
        </p>
    {% else %}
        <p class="explanation" style="color: red;">
            Error: GPT antwoord niet ondersteund
        </p>
    {% endif %}

    <!-- Choose taxonomy form -->
    {% if is_valid %}
    <form method="post" action="/{{ taxonomy }}/{{ single_question.questions_id }}/save/prompt={{ prompts_id }}">
        <div>
            <label for="taxonomy">Keuze taxonomie</label>
            <select id="taxonomy" name="taxonomy">
                <option value="gpt-{{ gpt_response.categorie|lower }}">GPT: {{ gpt_response.categorie|title }}</option>
                {% if taxonomy == 'bloom' %}
                    <option value="onthouden">Onthouden</option>
                    <option value="begrijpen">Begrijpen</option>
                    <option value="toepassen">Toepassen</option>
                    <option value="analyseren">Analyseren</option>
                    <option value="evalueren">Evalueren</option>
                    <option value="creëren">Creëren</option>
                {% elif taxonomy == 'rtti' %}
                    <option value="r">R</option>
                    <option value="t1">T1</option>
                    <option value="t2">T2</option>
                    <option value="i">I</option>
                {% endif %}
            </select>
        </div>

        <input class="submit-btn" type="submit" value="Taxonomie opslaan">
    </form>
    {% else %}
        <p style="color: red;">
            Error: GPT antwoord niet ondersteund
        </p>
    {% endif %}
</section>
{% endblock %}